# Railbird Monorepo Environment (root-level)
# ------------------------------------------------------------
# Single source of truth for local/dev/testnet execution.
# Target chain: Railbird MiniEVM rollup on Initia testnet
# Usage:
#   cp .env.example .env
#   set -a; source ./.env; set +a
# ------------------------------------------------------------

# ============================================
# Chain
# ============================================
# local | initia-testnet
CHAIN_ENV=local
RPC_URL=http://localhost:8545
CHAIN_ID=31337
# Initia testnet values (set after rollup provisioning):
# CHAIN_ENV=initia-testnet
# RPC_URL=https://your-rollup-rpc.example
# CHAIN_ID=<your-rollup-chain-id>
# INITIA_CHAIN_ID=<same-as-chain-id>
# INITIA_EXPLORER_URL=https://scan.testnet.initia.xyz

# ============================================
# Core Protocol Contract Addresses
# ============================================
# Comma-separated for multi-table (e.g. 0xTABLE1,0xTABLE2)
POKER_TABLE_ADDRESSES=0x0000000000000000000000000000000000000000,0x0000000000000000000000000000000000000000
PLAYER_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
PLAYER_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
VRF_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000

# VRF adapter type: production required for testnet/mainnet
VRF_ADAPTER_TYPE=production
# VRF operator address (deployment-time, optional)
# VRF_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================
# Indexer Service
# ============================================
# NOTE: leave PORT unset globally when running multiple services from one shell.
# Set per process (PORT=3002 ...)
# PORT=3002
DB_HOST=localhost
DB_PORT=5432
DB_NAME=playerco
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
# Event cursor start block
START_BLOCK=0
# When true, indexer always replays from START_BLOCK on boot (ignores DB cursor)
# INDEXER_REPLAY_ON_START=false
# When true, clears indexer DB tables before start (use only for planned re-index)
INDEXER_FLUSH_ON_START=false
# Per-environment recommended values: local=1000  testnet=2000  mainnet=3000
POLL_INTERVAL_MS=1000
# RPC eth_getLogs range limit-safe chunk size (<=100 recommended)
LOG_BLOCK_RANGE=90
# Number of proxy hops to trust for real client IP (0 = no proxy, 1 = single reverse proxy)
TRUST_PROXY_HOPS=1
# Comma-separated origins allowed by CORS (e.g. https://railbird.fun,https://www.railbird.fun)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: Redis URL for distributed rate limiting across multiple indexer instances.
# When set, rate limits are shared via Redis (60 req/min per IP).
# When unset, falls back to per-process in-memory limiting (sufficient for single instance).
# REDIS_URL=redis://localhost:6379

# ============================================
# OwnerView Service
# ============================================
# NOTE: set per process when needed (e.g. PORT=3001)
# PORT=3001
JWT_SECRET=replace-with-at-least-32-characters
# Required in non-local for /dealer/* routes
# DEALER_API_KEY=replace-with-strong-api-key
# Optional persistent storage dir for hole cards (non-local default: ./data/holecards)
# HOLECARD_DATA_DIR=./data/holecards
# Number of proxy hops to trust for real client IP (mirrors indexer TRUST_PROXY_HOPS)
# TRUST_PROXY_HOPS=1

# ============================================
# Agent / Keeper Bots
# ============================================
# Single-agent execution inputs
# OPERATOR_PRIVATE_KEY=0x...
# Per-agent table assignment (which table this agent plays on)
# POKER_TABLE_ADDRESS=0x...  (use this; AGENT_TABLE_ADDRESS is deprecated)
# 0.0 (very passive) ~ 1.0 (very aggressive)
AGGRESSION_FACTOR=0.3
# simple | gemini
AGENT_DECISION_ENGINE=simple
# Agent personality preset: shark | maniac | rock | adaptive
# When set, overrides AGGRESSION_FACTOR and injects persona into Gemini prompt.
# AGENT_PERSONA=shark
# Required when AGENT_DECISION_ENGINE=gemini (D-1)
# Get key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_MS=8000
# HTTP request timeout for bot API calls (ms)
REQUEST_TIMEOUT_MS=10000
# Transaction receipt wait timeout (ms)
TX_TIMEOUT_MS=60000
# Delay from turn start to action submission (ms)
TURN_ACTION_DELAY_MS=60000
DEPLOYER_PRIVATE_KEY=0x
KEEPER_PRIVATE_KEY=0x
VRF_OPERATOR_PRIVATE_KEY=0x
# Per-environment recommended values: local=1000  testnet=2000  mainnet=3000
VRF_OPERATOR_POLL_INTERVAL_MS=1000
VRF_OPERATOR_MIN_CONFIRMATIONS=1
VRF_OPERATOR_RESCAN_WINDOW=256
# VRF_OPERATOR_RESCAN_FROM_REQUEST_ID=1
# VRF_OPERATOR_RANDOM_SALT=railbird-vrf-operator
# Optional debug mode: force the same randomness for every fulfillment.
# Do not enable in production fairness-sensitive environments.
# VRF_OPERATOR_FIXED_RANDOMNESS=1
OWNERVIEW_URL=https://ownerview.railbird.fun
MAX_HANDS=0

# 9-player tournament runner
# Set TOURNAMENT_TABLE_ADDRESS to run all 9 agents on a single table
TOURNAMENT_TABLE_ADDRESS=0x

# Agent operator keys (seats 0-8 in the tournament table)
AGENT_1_OPERATOR_PRIVATE_KEY=0x
AGENT_2_OPERATOR_PRIVATE_KEY=0x
AGENT_3_OPERATOR_PRIVATE_KEY=0x
AGENT_4_OPERATOR_PRIVATE_KEY=0x
AGENT_5_OPERATOR_PRIVATE_KEY=0x
AGENT_6_OPERATOR_PRIVATE_KEY=0x
AGENT_7_OPERATOR_PRIVATE_KEY=0x
AGENT_8_OPERATOR_PRIVATE_KEY=0x
AGENT_9_OPERATOR_PRIVATE_KEY=0x

# Aggression factors (0=tight .. 1=aggressive) — default spread for diverse play styles
AGENT_1_AGGRESSION=0.10
AGENT_2_AGGRESSION=0.20
AGENT_3_AGGRESSION=0.30
AGENT_4_AGGRESSION=0.40
AGENT_5_AGGRESSION=0.50
AGENT_6_AGGRESSION=0.60
AGENT_7_AGGRESSION=0.70
AGENT_8_AGGRESSION=0.80
AGENT_9_AGGRESSION=0.90

# Legacy 2-table mode (TABLE_1_ADDRESS + TABLE_2_ADDRESS instead of TOURNAMENT_TABLE_ADDRESS)
# TABLE_1_ADDRESS=0x...
# TABLE_2_ADDRESS=0x...
# Per-agent table assignment (set to respective table address from POKER_TABLE_ADDRESSES)
# AGENT_1_TABLE_ADDRESS=0x...  (table 1)
# AGENT_2_TABLE_ADDRESS=0x...  (table 1)
# AGENT_3_TABLE_ADDRESS=0x...  (table 2)
# AGENT_4_TABLE_ADDRESS=0x...  (table 2)
# Optional per-agent engine/model overrides
# AGENT_1_DECISION_ENGINE=gemini
# AGENT_2_DECISION_ENGINE=gemini
# AGENT_3_DECISION_ENGINE=gemini
# AGENT_4_DECISION_ENGINE=gemini
# AGENT_SLOT=1

# ============================================
# Keeper / Vault Rebalancing (keeper bot)
# ============================================
# Auto buy-in: re-register evicted seats where keeper is the operator
# Requires keeper wallet to be the operator for managed seats
# AUTO_REFILL_ENABLED=false
# AUTO_REFILL_BUY_IN_AMOUNT=  (token units, e.g. 100000000000000000000 for 100 RCHIP)
# AUTO_REFILL_MIN_STACK=0      (refill when stack <= this value; 0 = only on eviction)
# RCHIP_TOKEN_ADDRESS=         (ERC20 chip token; auto-read from chipToken() if unset)

# Enable per-hand vault rebalancing after hand settlement
# ENABLE_REBALANCING=false
# Maximum MON to spend in a single rebalance buy (in ETH units, e.g. "0.1")
# REBALANCE_BUY_AMOUNT_MON=0
# Maximum agent tokens to sell in a single rebalance sell
# REBALANCE_SELL_AMOUNT_TOKENS=0

# ============================================
# DEX Contract Addresses
# ============================================
# Used by both the web app (NEXT_PUBLIC_*) and keeper/agent bots (server-side)
# RCHIP_TOKEN_ADDRESS=0x...
# DEX_ROUTER_ADDRESS=0x...

# ============================================
# Fleet Service (agent spawner)
# ============================================
# Public URL of the fleet service — required for the /create-agent UI (B-1)
# Local dev: http://localhost:4002
# Production: https://fleet.railbird.fun
# NEXT_PUBLIC_FLEET_URL=http://localhost:4002
# Comma-separated pre-funded operator private keys used by fleet's wallet pool
# FLEET_OPERATOR_KEYS=0xABC...,0xDEF...

# ============================================
# SideBet Pool Contract
# ============================================
# Deployed address of SideBetPool.sol (A-2)
# SIDE_BET_POOL_ADDRESS=0x0000000000000000000000000000000000000000
# NEXT_PUBLIC_SIDE_BET_POOL_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================
# Web App (client-side, NEXT_PUBLIC_*)
# ============================================
NEXT_PUBLIC_INDEXER_URL=https://indexer.railbird.fun
NEXT_PUBLIC_OWNERVIEW_URL=https://ownerview.railbird.fun
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_CHIP_SYMBOL=RCHIP
NEXT_PUBLIC_TABLE_MAX_SEATS=9
# Optional: override the WebSocket endpoint used by the table viewer.
# If not set, the WS URL is derived from NEXT_PUBLIC_INDEXER_URL by converting
# the protocol (https → wss, http → ws). Set this when deploying behind a proxy
# that exposes a separate WebSocket endpoint (e.g. wss://ws.example.com).
# NEXT_PUBLIC_WS_URL=wss://ws.example.com

# ============================================
# Deprecated variables (do not use in new deployments)
# ============================================
# POKER_TABLE_ADDRESS → use POKER_TABLE_ADDRESSES (comma-separated, multi-table)
# AGENT_TABLE_ADDRESS → use POKER_TABLE_ADDRESS (per-agent assignment)

# ============================================
# Legacy/optional
# ============================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/playerco
# DEALER_PRIVATE_KEY=0x...
