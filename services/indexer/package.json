{
  "name": "@playerco/indexer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "pnpm --filter @playerco/shared build && tsc",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "node --experimental-test-module-mocks --import tsx --test 'src/**/*.test.ts'",
    "lint": "echo 'lint not configured yet'",
    "typecheck": "tsc --noEmit",
    "db:flush": "node dist/db/flush.js",
    "db:migrate": "node dist/db/migrate.js",
    "migrate": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@playerco/shared": "workspace:*",
    "express": "^4.18.2",
    "ioredis": "^5.10.1",
    "pg": "^8.11.3",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "viem": "^2.21.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.9",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
