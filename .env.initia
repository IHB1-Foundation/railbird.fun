# Railbird — Initia Testnet (MiniEVM Rollup) Environment Template
# -------------------------------------------------------------------
# Target chain: Railbird MiniEVM rollup on Initia testnet
# Usage:
#   cp .env.initia .env
#   set -a; source ./.env; set +a
#
# Faucet:    https://faucet.testnet.initia.xyz
# Explorer:  https://scan.testnet.initia.xyz  (or rollup-specific explorer)
# Initia docs: https://docs.initia.xyz
#
# IMPORTANT: Fill in all 0x-placeholder addresses after running:
#   ./scripts/deploy/initia.sh
#   (results written to infra/initia/deployments.json)
# -------------------------------------------------------------------

# ============================================
# Chain
# ============================================
CHAIN_ENV=initia-testnet
CHAIN_NAME='Railbird Rollup (Initia)'
NATIVE_SYMBOL=INIT

# EVM-compatible JSON-RPC endpoint of the Railbird MiniEVM rollup
RPC_URL=https://rollup-node-production.up.railway.app

# Rollup EVM chain ID (numeric; used by viem/foundry/bots)
INITIA_CHAIN_ID=241167961210297
CHAIN_ID=241167961210297

# Cosmos chain ID (human-readable rollup ID, e.g. railbird-1)
INITIA_COSMOS_CHAIN_ID=railbird-1

# Block explorer for the rollup
INITIA_EXPLORER_URL=https://scan.testnet.initia.xyz

# ============================================
# Core Protocol Contract Addresses
# (fill in after running DeployInitia.s.sol — see infra/initia/deployments.json)
# ============================================
CHIP_TOKEN_ADDRESS=0x356524F2c8233eE28F0D11eb57906A46aaFb3017
# Comma-separated for multi-table
POKER_TABLE_ADDRESSES=0xCDd2AD6dFc1191bEB395a157d42fB6983103c713,0xd4c0a9dBaa1247F9074ce32D03fF31491DEB6B21
PLAYER_REGISTRY_ADDRESS=0x2D3F047055b6113e8E919Bcd3589E09B0CDDfD66
PLAYER_VAULT_ADDRESS=0x2e565620b08297C1Cb899154bC9724De0b7C1386
VRF_ADAPTER_ADDRESS=0xD966b352766D01323f84574335029eCf76392110

# VRF adapter type: must be "production" for testnet
VRF_ADAPTER_TYPE=production
# VRF_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000

# ============================================
# Indexer Service
# (Initia MiniEVM blocks are ~100ms — use smaller poll interval & batch size)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=railbird
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
START_BLOCK=0
POLL_INTERVAL_MS=250
# ADR-020: 100ms blocks × 100 range = 10 seconds per fetch — tuned for Initia MiniEVM
LOG_BLOCK_RANGE=100

# ============================================
# OwnerView Service
# ============================================
JWT_SECRET=replace-with-at-least-32-characters
# DEALER_API_KEY=replace-with-strong-api-key
# HOLECARD_DATA_DIR=./data/holecards

# ============================================
# Agent / Keeper Bots
# ============================================
DEPLOYER_PRIVATE_KEY=0x
KEEPER_PRIVATE_KEY=0x
VRF_OPERATOR_PRIVATE_KEY=0x
VRF_OPERATOR_POLL_INTERVAL_MS=250
# ADR-020: at 100ms blocks, 20 confirmations ≈ 2 seconds — safe reorg buffer
VRF_OPERATOR_MIN_CONFIRMATIONS=20
# rescan window covers ~5 seconds of history at 100ms blocks
VRF_OPERATOR_RESCAN_WINDOW=50
AGGRESSION_FACTOR=0.3
AGENT_DECISION_ENGINE=simple
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
GEMINI_TIMEOUT_MS=8000
TURN_ACTION_DELAY_MS=60000
OWNERVIEW_URL=https://ownerview-production-496d.up.railway.app
MAX_HANDS=0

# treasury rebalancing disabled on Initia (no DEX integration yet)
ENABLE_REBALANCING=false

# Agent operator keys (seats 0-3 for 4-agent demo)
AGENT_1_OPERATOR_PRIVATE_KEY=0x
AGENT_2_OPERATOR_PRIVATE_KEY=0x
AGENT_3_OPERATOR_PRIVATE_KEY=0x
AGENT_4_OPERATOR_PRIVATE_KEY=0x

AGENT_1_AGGRESSION=0.20
AGENT_2_AGGRESSION=0.40
AGENT_3_AGGRESSION=0.60
AGENT_4_AGGRESSION=0.80

# ============================================
# Web App (client-side, NEXT_PUBLIC_*)
# ============================================
NEXT_PUBLIC_CHAIN_ENV=initia-testnet
NEXT_PUBLIC_APP_URL=https://www.railbird.fun
NEXT_PUBLIC_CHAIN_ID=241167961210297
NEXT_PUBLIC_CHAIN_NAME="Railbird Rollup (Initia)"
NEXT_PUBLIC_NATIVE_SYMBOL=INIT
NEXT_PUBLIC_BLOCK_EXPLORER=https://scan.testnet.initia.xyz
NEXT_PUBLIC_INDEXER_URL=https://indexer-production-7498.up.railway.app
NEXT_PUBLIC_OWNERVIEW_URL=https://ownerview-production-496d.up.railway.app
NEXT_PUBLIC_RPC_URL=https://rollup-node-production.up.railway.app
NEXT_PUBLIC_CHIP_SYMBOL=RCHIP
NEXT_PUBLIC_TABLE_MAX_SEATS=9

# Initia-native feature flags
# nad.fun trading widget is disabled on Initia (no DEX equivalent yet)
NEXT_PUBLIC_ENABLE_TRADING_WIDGET=false
# Auto-sign session UX (InterwovenKit) — enabled by default on Initia
NEXT_PUBLIC_ENABLE_AUTOSIGN=true
# .init username resolution
NEXT_PUBLIC_ENABLE_INIT_USERNAMES=true

# InterwovenKit chain config (set matching your rollup chain ID)
NEXT_PUBLIC_INTERWOVEN_CHAIN_ID=241167961210297
