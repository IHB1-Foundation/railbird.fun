{
  "name": "@playerco/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next dist",
    "lint": "next lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
