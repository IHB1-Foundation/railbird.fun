{
  "name": "@playerco/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:e2e": "rm -rf .next && next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next dist",
    "lint": "next lint --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "Initial JS payload (/)",
      "path": ".next/static/chunks/main-*.js",
      "limit": "120 KB",
      "gzip": true
    },
    {
      "name": "App framework chunk",
      "path": ".next/static/chunks/framework-*.js",
      "limit": "60 KB",
      "gzip": true
    },
    {
      "name": "Total first-load JS",
      "path": ".next/static/chunks/{main,framework,webpack}-*.js",
      "limit": "300 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "@playerco/shared": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "next": "14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@next/bundle-analyzer": "^16.2.3",
    "@playwright/test": "^1.59.1",
    "@size-limit/file": "^11.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "jsdom": "^29.0.1",
    "size-limit": "^11.2.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
